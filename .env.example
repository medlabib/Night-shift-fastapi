# Copy to .env and adjust. docker-compose reads this file automatically.

# Signs session cookies, share links and reset tokens.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-before-deploying

ENVIRONMENT=production
APP_PORT=8000

POSTGRES_USER=nightshift
POSTGRES_PASSWORD=nightshift
POSTGRES_DB=nightshift

# Set true when serving over HTTPS so session cookies are HTTPS-only.
COOKIE_SECURE=false

# Seconds the solver may spend per rota. It usually proves an optimal
# answer well inside this; large departments may return a very good
# feasible one at the limit.
SOLVER_TIME_LIMIT=10

# Search workers. 0 matches the host's cores. Set 1 for reproducible rotas:
# a rota request usually has many equally-optimal answers, and parallel
# workers return a different one each run.
SOLVER_WORKERS=0

# ── Outbound email ──
# Without SMTP_HOST the app logs messages instead of sending them, which is
# fine for development but leaves invitations and password resets undelivered.
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_USER=night-shift@example.org
# SMTP_PASSWORD=
# SMTP_STARTTLS=true       # port 587; use SMTP_SSL=true for port 465
# MAIL_FROM=night-shift@example.org
# MAIL_FROM_NAME=Night Shift

# Where links in email should point. Set this in production: behind a proxy
# the request's own host is the internal one.
# PUBLIC_URL=https://rota.example.org
