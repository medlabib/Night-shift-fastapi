# Copy to .env and adjust. docker-compose reads this file automatically.

# Signs session cookies, share links and reset tokens.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-before-deploying

ENVIRONMENT=production
APP_PORT=8000

POSTGRES_USER=nightshift
POSTGRES_PASSWORD=nightshift
POSTGRES_DB=nightshift

# Set true when serving over HTTPS so session cookies are HTTPS-only.
COOKIE_SECURE=false

# Seconds the solver may spend per rota. It usually proves an optimal
# answer well inside this; large departments may return a very good
# feasible one at the limit.
SOLVER_TIME_LIMIT=10
